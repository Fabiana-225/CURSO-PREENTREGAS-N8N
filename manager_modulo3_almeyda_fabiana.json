        "description": "Usar esta herramienta para calcular una cotización formal (precio total, descuento por volumen aplicable) una vez confirmado el stock disponible. Requiere producto, cantidad y precio unitario.",
        "source": "database",
        "workflowId": { "__rl": true, "value": "WORKER2_WORKFLOW_ID_PLACEHOLDER", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "producto": "={{ $fromAI('producto', 'Nombre del producto a cotizar', 'string') }}",
            "cantidad": "={{ $fromAI('cantidad', 'Cantidad de unidades', 'number') }}",
            "precio_unitario": "={{ $fromAI('precio_unitario', 'Precio unitario obtenido del Worker de stock', 'number') }}"
          }
