    {
      "parameters": {
        "name": "consultar_stock_cleanpro",
        "description": "Usar esta herramienta para consultar stock disponible y precio unitario de productos de limpieza institucional en el catálogo de CleanPro Distribuciones S.A. Requiere el nombre del producto y la cantidad solicitada.",
        "source": "database",
